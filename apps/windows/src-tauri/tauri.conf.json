{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "金山打红心",
  "version": "0.3.0",
  "identifier": "com.jinshan.hongxin",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. --workspace=@jinshan/client run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "金山打红心 · 打黑心",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0d0c0b",
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
