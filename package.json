{
  "name": "jinshan-hongxin",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:core": "tsc -b",
    "build:client": "npm --workspace=@jinshan/client run build",
    "build": "tsc -b && npm --workspace=@jinshan/client run build",
    "build:apk": "npm run build && node apps/android/scripts/build-apk.mjs",
    "build:ota": "npm run build && node scripts/build-web-bundle.mjs",
    "dev:win": "npm --workspace=@jinshan/windows run dev",
    "build:win": "npm run build && npm --workspace=@jinshan/windows run build",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo apps/*/dist apps/*/*.tsbuildinfo apps/android/build apps/android/dist",
    "start:server": "npm run build && node apps/server/dist/index.js",
    "test": "tsc -b && node --test packages/game-core/dist/__tests__/*.test.js apps/server/dist/__tests__/*.test.js apps/client/test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2"
  }
}
